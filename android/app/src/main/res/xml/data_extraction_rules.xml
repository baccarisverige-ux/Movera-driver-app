<?xml version="1.0" encoding="utf-8"?>
<!-- Driver data (trips, contacts, vehicle document photos, Ride-check audio)
     stays on this device. It is excluded from cloud backup and
     device-to-device transfer. "root" is the app data directory: it covers
     app_flutter (getApplicationDocumentsDirectory, Ride-check audio), which
     the "file" domain does not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
